{
  "steps": [
    {
      "run": "friends",
      "expect": {
        "contains": [
          "0 posts, 0 friends",
          "does not know its own name"
        ]
      }
    },
    {
      "run": "friends add bram",
      "expect": {
        "code": 1,
        "contains": [
          "friends settings set house"
        ]
      }
    },
    {
      "run": "friends settings set house anna.okayiris.com",
      "expect": {
        "contains": [
          "house: anna."
        ]
      }
    },
    {
      "run": "friends settings set name Anna de Vries",
      "expect": {
        "contains": [
          "name: Anna de Vries."
        ]
      }
    },
    {
      "run": "friends settings set bio Fotografe uit Utrecht",
      "expect": {
        "contains": [
          "bio: Fotografe uit Utrecht."
        ]
      }
    },
    {
      "run": "friends settings set audience everyone",
      "expect": {
        "code": 1,
        "contains": [
          "audience is friends"
        ]
      }
    },
    {
      "run": "friends post \"Dag aan het strand\" photo https://example.com/beach.png",
      "expect": {
        "contains": [
          "Posted #1 with a photo, for your friends."
        ]
      }
    },
    {
      "run": "friends post \"Zaterdag weer open\" public",
      "expect": {
        "contains": [
          "Posted #2, for everyone"
        ]
      }
    },
    {
      "run": "friends post photo /nope/nothing.jpg",
      "expect": {
        "code": 1,
        "contains": [
          "There is no file /nope/nothing.jpg."
        ]
      }
    },
    {
      "run": "friends post photo http://example.com/x.png",
      "expect": {
        "code": 1,
        "contains": [
          "starts with https://"
        ]
      }
    },
    {
      "run": "friends wall",
      "expect": {
        "contains": [
          "#2  just now, public: Zaterdag weer open",
          "#1  just now, friends only: Dag aan het strand [photo]"
        ]
      }
    },
    {
      "run": "friends",
