{
  "steps": [
    {
      "run": "sun",
      "expect": {
        "code": 1,
        "contains": [
          "No home is set yet."
        ]
      }
    },
    {
      "run": "sun settings set place 52.0908,5.1222",
      "expect": {
        "contains": [
          "Home is 52.09, 5.12."
        ]
      }
    },
    {
      "run": "sun",
      "expect": {
        "contains": [
          "sunrise 07:34, sunset 19:25, 11 h 51 min of daylight (4 min less than the day before)",
          "Light from 07:01 until 19:59",
          "highest at 13:30"
        ]
      }
    },
    {
      "run": "sun moon",
      "expect": {
        "contains": [
          "The moon now: waning gibbous, 97% lit.",
          "Last quarter: Sat 03 Oct around 15:25",
          "New moon: Sat 10 Oct around 17:50",
          "Full moon: Mon 26 Oct around 05:11"
        ]
      }
    },
    {
      "run": "sun on 21 Dec",
      "expect": {
        "contains": [
          "Mon 21 Dec 2026: sunrise 08:45, sunset 16:29, 7 h 43 min of daylight"
        ]
      }
    },
    {
      "run": "sun on 2026-06-21 69.65,18.96",
      "expect": {
        "contains": [
          "the sun does not set (midnight sun)"
        ]
      }
    },
    {
      "run": "sun on 2026-12-21 69.65,18.96",
      "expect": {
        "contains": [
          "the sun does not rise (polar night)"
        ]
      }
    },
    {
      "run": "sun settings set place Utrecht",
      "expect": {
        "contains": [
          "Home is Utrecht"
        ]
      }
    },
    {
      "run": "sun on someday",
      "expect": {
        "code": 1,
        "contains": [
          "sun on <date> [place]"
        ]
      }
    }
  ]
}
