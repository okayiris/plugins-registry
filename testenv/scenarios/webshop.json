  "screen": {
    "lang": "nl",
    "before": [
      "webshop settings set name Atelier Anna",
      "webshop settings set kvk 12345678",
      "webshop settings set email anna@example.com",
      "webshop settings set shipping 4,95",
      "webshop settings set terms Binnen 3 werkdagen in huis. 14 dagen bedenktijd.",
      "webshop add \"Mok met naam\" 12,50 stock 3 text \"Handgemaakt, vaatwasserbestendig\"",
      "webshop add Kaart 3",
      "webshop add \"Poster A3\" 19,95 stock 0"
    ],
    "actions": [
      {
        "click": "text=Bestellingen om af te handelen"
      },
      {
        "said": "webshop orders"
      }
    ],
    "routes": {
      "shop": [
        {
          "shot": "products"
        },
        {
          "expect": "text=Uitverkocht"
        },
        {
          "expect": "text=Nog maar 3 over"
        },
        {
          "click": ".k-btn:has-text('In winkelmand')"
        },
