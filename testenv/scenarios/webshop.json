{
  "vault": [
    "mollie|api.mollie.com"
  ],
  "stub": "stubs/mollie.py",
  "steps": [
    {
      "run": "webshop",
      "expect": {
        "contains": [
          "Your shop is open, with 0 products",
          "Before you share the shop, add a shop name"
        ]
      }
    },
    {
      "run": "webshop settings set name Atelier Anna",
      "expect": {
        "contains": [
          "name: Atelier Anna."
        ]
      }
    },
    {
      "run": "webshop add \"Mok met naam\" 12,50 stock 3 text \"Handgemaakt\"",
      "expect": {
        "contains": [
          "#1 Mok met naam is in the shop for € 12,50, 3 in stock."
        ]
      }
    },
    {
      "run": "webshop add Kaart 3 photo https://example.com/kaart.jpg",
      "expect": {
        "contains": [
          "#2 Kaart is in the shop for € 3,00, no limit."
        ]
      }
    },
    {
      "run": "webshop add Poster abc",
      "expect": {
        "code": 1,
        "contains": [
          "abc is not a price."
        ]
      }
    },
    {
      "run": "webshop settings set shipping 4,95",
      "expect": {
        "contains": [
          "shipping: 4,95."
        ]
      }
    },
    {
      "run": "webshop settings set free_from 25",
      "expect": {
        "contains": [
          "free_from: 25."
        ]
      }
    },
    {
      "run": "webshop",
      "stdin": {
        "plugin": "webshop",
        "route": "shop",
        "method": "POST",
        "path": "api",
        "query": {},
        "body": {
          "action": "catalog"
        },
        "house": "anna",
        "lang": "nl",
        "public": true,
        "owner": "Anna",
        "at": 1790000000000
      },
      "expect": {
        "json": {
          "shop.name": "Atelier Anna",
          "shop.shipping": 495,
          "products.0.price": 1250,
          "products.0.left": 3,
          "products.length": 2
        }
      }
    },
    {
      "run": "webshop",
